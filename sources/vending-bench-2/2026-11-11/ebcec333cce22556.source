	--color-GLM-5.2: #9D174D;
}</style><!----><!----><!--]--><!----> <!--[--><!--[-1--><!--]--><!--]--><!----></div><!--]--> <div class="text-center text-sm text-gray-600 -mt-11 mb-4">Days in simulation</div></div><!----></div> <div class="not-prose flex gap-2 mt-2 mb-14"><button class="px-3 py-1.5 text-sm rounded-full transition-colors bg-gray-900 text-white" aria-pressed="true" title="Highest average balance from each of OpenAI, Anthropic, xAI, and Zhipu">Frontier</button> <button class="px-3 py-1.5 text-sm rounded-full transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200" aria-pressed="false">Open</button> <button class="px-3 py-1.5 text-sm rounded-full transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200" aria-pressed="false">All</button></div> <h3>Current leaderboard</h3> <p class="text-sm text-gray-500 mb-4">Average across runs</p> <div class="not-prose mb-4"><div class="relative w-full overflow-auto"><table class="w-full caption-bottom text-sm"><!--[--><thead class="[&amp;_tr]:border-b"><!--[--><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors"><!--[--><th class="text-muted-foreground h-12 px-4 text-left align-middle font-medium [&amp;:has([role=checkbox])]:pr-0"><!--[--><!--]--></th><!----> <th class="text-muted-foreground h-12 px-4 text-left align-middle font-medium [&amp;:has([role=checkbox])]:pr-0"><!--[--><!---->Model<!--]--></th><!----> <th class="text-muted-foreground h-12 px-4 text-left align-middle font-medium [&amp;:has([role=checkbox])]:pr-0"><!--[--><!---->Money Balance<!--]--></th><!----><!--]--></tr><!--]--></thead><!----> <tbody class="[&amp;_tr:last-child]:border-0"><!--[--><!--[--><tr class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors"><!--[--><td class="p-4 align-middle [&amp;:has([role=checkbox])]:pr-0 text-muted-foreground"><!--[--><!---->1<!--]--></td><!----> <td class="p-4 align-middle [&amp;:has([role=checkbox])]:pr-0"><!--[--><div class="flex items-center gap-1"><!--[0--><img src